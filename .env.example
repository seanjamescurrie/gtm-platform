# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# Queue dashboard (#12) at http://localhost:3000/admin/queues, user `admin`. Unset means off.
# At least 12 characters. Local use only: basic auth is not enough for a deployed service.
# QUEUE_DASHBOARD_PASSWORD=

# Companies House REST API key (Basic auth username, empty password).
# Register an application at https://developer.company-information.service.gov.uk/ and create a REST key.
COMPANIES_HOUSE_API_KEY=

# Local infrastructure (compose.yaml). Defaults match compose.yaml; change the ports if they clash.
POSTGRES_USER=gtm
POSTGRES_PASSWORD=gtm
POSTGRES_DB=gtm
POSTGRES_PORT=5432
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Connection strings used by the apps. Keep in sync with the values above.
DATABASE_URL=postgres://gtm:gtm@localhost:5432/gtm
REDIS_URL=redis://localhost:6379
# Response cache (#11). Unset means REDIS_URL. In production, point it at a separate cluster that may evict.
# REDIS_CACHE_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
